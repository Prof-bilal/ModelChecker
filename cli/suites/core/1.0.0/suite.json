                  "required": ["street", "postcode", "city", "country"],
                  "additionalProperties": false
                }
              },
              "required": ["name", "address"],
              "additionalProperties": false
            }
          },
          "required": ["order_id", "total", "carrier", "customer"],
          "additionalProperties": false
        }
      }
    },
