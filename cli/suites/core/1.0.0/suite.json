{
  "meta": {
    "id": "core",
    "version": "1.0.0",
    "$comment": "The full 30-case V1 suite from docs/benchmarks.md §2–3 (15 structured_output + 15 tool_calling). Cases are definitions, not measurements (docs/benchmarks.md honesty note)."
  },
  "cases": [
    {
      "case_id": "so-001",
      "capability": "structured_output",
      "version": "1",
      "input": {
        "prompt": "Extract the invoice details from the following text into JSON.\n\nText: Invoice INV-2031 from Northwind Traders, dated 2026-08-14, total 1250.00 GBP, due 2026-09-13."
      },
      "scoring": "json_schema@1",
      "scoring_params": {
        "schema": {
          "type": "object",
          "properties": {
            "invoice_id": { "type": "string" },
            "vendor": { "type": "string" },
            "total": { "type": "number" },
            "due_date": { "type": "string", "format": "date" }
          },
          "required": ["invoice_id", "vendor", "total", "due_date"],
          "additionalProperties": false
        }
      }
    },
    {
      "case_id": "so-002",
      "capability": "structured_output",
      "version": "1",
      "input": {
        "prompt": "Extract the user profile into JSON.\n\nText: Maria Chen has been a customer since 2021. Her account email is maria.chen@example.com and her phone is +44 20 7946 0958.\n\nSchema notes: fields 'loyalty_tier', 'preferred_contact' and 'birthday' are optional; no data for them is provided. Do not invent values for optional fields."
      },
      "scoring": "json_schema@1",
      "scoring_params": {
        "schema": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "customer_since": { "type": "integer" },
            "email": { "type": "string" },
            "phone": { "type": "string" },
            "loyalty_tier": { "type": "string" },
            "preferred_contact": { "type": "string" },
            "birthday": { "type": "string", "format": "date" }
          },
          "required": ["name", "customer_since", "email", "phone"],
          "additionalProperties": false
        }
      }
    },
    {
      "case_id": "so-003",
      "capability": "structured_output",
      "version": "1",
      "input": {
        "prompt": "Extract the order figures into JSON.\n\nText: The warehouse shipped 1,250 units at £3.50 per unit on order PO-8841."
      },
      "scoring": "json_schema@1",
      "scoring_params": {
        "schema": {
          "type": "object",
          "properties": {
            "order_id": { "type": "string" },
            "units": { "type": "integer" },
            "unit_price": { "type": "number" }
          },
          "required": ["order_id", "units", "unit_price"],
          "additionalProperties": false
        }
      }
    },
    {
      "case_id": "so-004",
      "capability": "structured_output",
      "version": "1",
      "input": {
        "prompt": "Classify the support ticket into JSON.\n\nText: Customer writes: \"The app crashes every time I try to attach a photo since the last update.\"\n\nThe 'category' field must be exactly one of: \"bug\", \"feature_request\", \"billing\", \"account\", \"other\"."
      },
      "scoring": "json_schema@1",
      "scoring_params": {
        "schema": {
          "type": "object",
          "properties": {
            "category": { "type": "string", "enum": ["bug", "feature_request", "billing", "account", "other"] }
          },
          "required": ["category"],
          "additionalProperties": false
        }
      }
    },
    {
      "case_id": "so-005",
      "capability": "structured_output",
      "version": "1",
      "input": {
        "prompt": "Extract the order record into nested JSON.\n\nText: Order ORD-552 was placed by customer Jonas Weber, who lives at Ahornweg 12, 04109 Leipzig, Germany. The order total is 89.90 EUR and it ships via DHL."
      },
      "scoring": "json_schema@1",
      "scoring_params": {
        "schema": {
          "type": "object",
          "properties": {
            "order_id": { "type": "string" },
            "total": { "type": "number" },
            "carrier": { "type": "string" },
            "customer": {
              "type": "object",
