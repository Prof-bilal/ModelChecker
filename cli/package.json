{
  "name": "modelcheck-cli",
  "version": "0.2.0",
  "description": "Local regression testing for AI applications: baseline, verify and compare model or configuration changes with deterministic assertions and CI verdicts.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "modelcheck": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Prof-bilal/ModelChecker.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/Prof-bilal/ModelChecker#readme",
  "bugs": {
    "url": "https://github.com/Prof-bilal/ModelChecker/issues"
  },
  "keywords": [
    "llm",
    "evaluation",
    "evals",
    "benchmark",
    "model",
    "cli",
    "structured-output",
    "tool-calling",
    "openai",
    "anthropic",
    "openrouter"
  ],
  "files": [
    "dist",
    "suites",
    "examples",
    "CHANGELOG.md",
    "!dist/**/*.test.js",
    "!dist/tests",
    "!**/*.map"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "prepack": "npm run build && node scripts/prepare-package.mjs",
    "prepublishOnly": "npm run lint && npm test && npm run test:package",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node scripts/test.mjs",
    "test:package": "npm run prepack && node scripts/test-package.mjs",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.9.1"
  }
}
